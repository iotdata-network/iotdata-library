<?xml version="1.0" encoding="UTF-8"?>
<!--
    IoT Sensor Telemetry Protocol
    Copyright(C) 2026 Matthew Gream (https://libiotdata.org)

    iotdata-fields-context.xml - context fields

    THIS IS THE SOURCE. iotdata_fields.h and iotdata_fields.c are generated from
    it by generators/iotdata-generator-fields.js through the templates in
    generators/templates, and editing them directly loses the edit at the next
    `make generate`.

    WHAT IS HERE AND WHAT IS IN THE TEMPLATE. This document carries what is true
    of a field in any language: its identifier, its quantities, their ranges and
    wire widths, the errors it can raise, its documentation -- and, for now, the
    bodies of its operations as literal C. The template carries what is true of
    the LANGUAGE: every brace, guard, typedef and macro form. So a toolchain that
    needs the C shaped differently is a template edit, not a generator change.

    <impl> IS LANGUAGE-SPECIFIC AND DELIBERATELY VERBATIM. Lifting the existing
    bodies in unchanged is the whole approach: nothing is re-derived, so nothing
    silently changes behaviour. A later <abstract> element may describe a
    quantisation rule declaratively, and the generator will use it only where no
    <impl> for that language and hook exists -- so a field migrates when someone
    chooses to migrate it, and until then the C that has been in service stays
    the definition.

    WHEN AN <impl> HAS A 'when' ATTRIBUTE it is selected by build configuration:
    'floating' and 'integer' are the two forms of iotdata_float_t. Several
    quantities need genuinely different arithmetic in the two, not the same
    expression at two widths, which is why they are separate bodies rather than
    one body and a cast.

    IDENTIFIERS are grouped in blocks of 16 per family, x0..x7 atomic and
    x8..xF composite. A convention only: identifiers are compared, never
    calculated with. 0x0000 is unassigned, 0x8000 and above belong to the
    implementer, 0xFFFF means none. TLV has no identifier.

    Fields that say WHEN and WHERE a reading was taken rather than what was read.
    Context for a measurement instead of a measurement, which is why they sit
    apart from the subject families: a station reporting temperature and a meter
    reporting radiation both want them, and neither owns them.
-->
<fields>

    <!-- ---------------------------------------------------------------------------
        DATETIME - seconds from the start of the year, to five-second resolution.

        The first field whose quantise_ function is named for something other than
        its member: the member is datetime_secs and the function is
        quantise_datetime, taking an argument called datetime. The argument name
        is almost never the member name anywhere in the protocol, and the two
        forms of a floating quantity differ in the argument AND the return type,
        so an <impl> states its own signature rather than having one guessed for
        it.
    -->
    <field name="datetime" id="0x0081u" bits="IOTDATA_DATETIME_BITS">

        <documentation>
            <note for="field"><![CDATA[Field DATETIME]]></note>
        </documentation>

        <constants>
            <constant name="BITS" value="24"/>
            <constant name="RES" value="5"/>
            <!-- THE SHIFT IS EXPLICITLY 32-BIT. `1 << 24` promotes its left operand to int,
                 and where int is 16 bits -- which it is on most 8- and 16-bit targets -- that is
                 undefined behaviour, not a large number. This constant feeds the range check, so
                 on such a target the check would have been built on rubble. Identical value
                 wherever int is 32 bits, and correct where it is not. -->
            <constant name="MAX" value="(((uint32_t)1 &lt;&lt; IOTDATA_DATETIME_BITS) - 1)"/>
        </constants>

        <quantity name="datetime_secs" type="uint32_t" param="seconds_from_year_start" stem="datetime">
            <check expr="(seconds_from_year_start / IOTDATA_DATETIME_RES) &gt; IOTDATA_DATETIME_MAX" error="HIGH" text="Datetime ticks above maximum"/>
            <impl lang="c" hook="quantise" arg="uint32_t datetime"><![CDATA[    return (uint32_t)(datetime / IOTDATA_DATETIME_RES);
]]></impl>
            <impl lang="c" hook="dequantise"><![CDATA[    return (uint32_t)(raw * IOTDATA_DATETIME_RES);
]]></impl>
        </quantity>

        <impl lang="c" hook="pack"><![CDATA[    const iotdata_field_datetime_t *const v = vv;
    return bits_write(buf, bb, bp, quantise_datetime(v->datetime_secs), IOTDATA_DATETIME_BITS);
]]></impl>
        <impl lang="c" hook="unpack"><![CDATA[    iotdata_field_datetime_t *const v = vv;
    if (*bp + IOTDATA_DATETIME_BITS > bb)
        return false;
    v->datetime_secs = dequantise_datetime(bits_read(buf, bb, bp, IOTDATA_DATETIME_BITS));
    return true;
]]></impl>
        <impl lang="c" hook="json_get"><![CDATA[    (void)scratch;
    cJSON *j = cJSON_GetObjectItem(root, label);
    if (!j)
        return IOTDATA_OK;
    return iotdata_encode_datetime(enc, (uint32_t)j->valueint);
]]></impl>
        <impl lang="c" hook="json_set"><![CDATA[    const iotdata_field_datetime_t *const v = vv;
    (void)scratch;
    cJSON_AddNumberToObject(root, label, v->datetime_secs);
]]></impl>
        <impl lang="c" hook="dump"><![CDATA[    (void)label;
    size_t s = *bp;
    uint32_t r = bits_read(buf, bb, bp, IOTDATA_DATETIME_BITS);
    const uint32_t secs = dequantise_datetime(r);
    snprintf(dump->_dec_buf, sizeof(dump->_dec_buf), "day %" PRIu32 " %02" PRIu32 ":%02" PRIu32 ":%02" PRIu32 " (%" PRIu32 "s)", secs / 86400, (secs % 86400) / 3600, (secs % 3600) / 60, secs % 60, secs);
    n = dump_add(dump, n, s, IOTDATA_DATETIME_BITS, r, dump->_dec_buf, "5s res", "datetime");
    return n;
]]></impl>
        <impl lang="c" hook="print"><![CDATA[    const iotdata_field_datetime_t *const v = vv;
    bprintf(bp, "  %s:%s day %" PRIu32 " %02" PRIu32 ":%02" PRIu32 ":%02" PRIu32 " (%" PRIu32 "s)\n", label, _padd(label), v->datetime_secs / 86400, (v->datetime_secs % 86400) / 3600, (v->datetime_secs % 3600) / 60, v->datetime_secs % 60, v->datetime_secs);
]]></impl>

    </field>

</fields>
