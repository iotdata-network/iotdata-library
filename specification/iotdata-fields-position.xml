<?xml version="1.0" encoding="UTF-8"?>
<!--
    IoT Sensor Telemetry Protocol
    Copyright(C) 2026 Matthew Gream (https://libiotdata.org)

    iotdata-fields-position.xml - position fields

    THIS IS THE SOURCE. iotdata_fields.h and iotdata_fields.c are generated from
    it by generators/iotdata-generator-fields.js through the templates in
    generators/templates, and editing them directly loses the edit at the next
    `make generate`.

    WHAT IS HERE AND WHAT IS IN THE TEMPLATE. This document carries what is true
    of a field in any language: its identifier, its quantities, their ranges and
    wire widths, the errors it can raise, its documentation -- and, for now, the
    bodies of its operations as literal C. The template carries what is true of
    the LANGUAGE: every brace, guard, typedef and macro form. So a toolchain that
    needs the C shaped differently is a template edit, not a generator change.

    <impl> IS LANGUAGE-SPECIFIC AND DELIBERATELY VERBATIM. Lifting the existing
    bodies in unchanged is the whole approach: nothing is re-derived, so nothing
    silently changes behaviour. A later <abstract> element may describe a
    quantisation rule declaratively, and the generator will use it only where no
    <impl> for that language and hook exists -- so a field migrates when someone
    chooses to migrate it, and until then the C that has been in service stays
    the definition.

    WHEN AN <impl> HAS A 'when' ATTRIBUTE it is selected by build configuration:
    'floating' and 'integer' are the two forms of iotdata_float_t. Several
    quantities need genuinely different arithmetic in the two, not the same
    expression at two widths, which is why they are separate bodies rather than
    one body and a cast.

    IDENTIFIERS are grouped in blocks of 16 per family, x0..x7 atomic and
    x8..xF composite. A convention only: identifiers are compared, never
    calculated with. 0x0000 is unassigned, 0x8000 and above belong to the
    implementer, 0xFFFF means none. TLV has no identifier.

    Where a thing is. Its own document because it is the only field that works
    in DOUBLES, and the only one with a third build axis beneath it -- doubles
    can be narrowed to floats independently of whether the build has floating
    point at all.
-->
<fields>

    <!-- ---------------------------------------------------------------------------
        POSITION - latitude and longitude, 24 bits each.

        THE ONLY FIELD THAT WORKS IN DOUBLES, and the only one with a third
        build axis under it: IOTDATA_NO_FLOATING_DOUBLES makes iotdata_double_t
        a float, which changes round to roundf inside the quantiser. That #if
        lives INSIDE the body rather than splitting it, so it rides along in
        the body as written and needs nothing from the generator.

        The two arms proper are the usual ones. In a floating build the setter
        takes degrees and the quantiser scales them across the 24-bit span; in
        an integer build the same quantity arrives in ten-millionths of a
        degree and the arithmetic is done in int64_t to keep the product from
        overflowing. Latitude and longitude differ only in their offset and
        range, but each carries its own functions and its own constants rather
        than sharing: the same choice made for WIND_GUST against WIND_SPEED.

        Its offsets and ranges are marked early so they stay above the storage,
        where the hand-written original grouped them.
    -->    <field name="position" id="0x0080u" bits="IOTDATA_POSITION_LAT_BITS + IOTDATA_POSITION_LON_BITS">
        <documentation>
            <note for="field"><![CDATA[Field POSITION (LATITUDE, LONGITUDE)]]></note>
        </documentation>
        <constants>
            <constant name="LAT_OFFSET" value="90.0" early="yes"/>
            <constant name="LAT_RANGE" value="180.0" early="yes"/>
            <constant name="LON_OFFSET" value="180.0" early="yes"/>
            <constant name="LON_RANGE" value="360.0" early="yes"/>
            <constant name="LAT_OFFSET_I" value="900000000LL" early="yes"/>
            <constant name="LAT_RANGE_I" value="1800000000LL" early="yes"/>
            <constant name="LON_OFFSET_I" value="1800000000LL" early="yes"/>
            <constant name="LON_RANGE_I" value="3600000000LL" early="yes"/>
            <constant name="LAT_LOW" value="(-90.0)" when="floating"/>
            <constant name="LAT_HIGH" value="(90.0)" when="floating"/>
            <constant name="LON_LOW" value="(-180.0)" when="floating"/>
            <constant name="LON_HIGH" value="(180.0)" when="floating"/>
            <constant name="LAT_LOW" value="(-900000000)" when="integer"/>
            <constant name="LAT_HIGH" value="(900000000)" when="integer"/>
            <constant name="LON_LOW" value="(-1800000000)" when="integer"/>
            <constant name="LON_HIGH" value="(1800000000)" when="integer"/>
            <constant name="LAT_BITS" value="24"/>
            <constant name="LON_BITS" value="24"/>
            <constant name="SCALE" value="16777215 /* (1 << 24) - 1 */"/>
            <constant name="BITS" value="(IOTDATA_POSITION_LAT_BITS + IOTDATA_POSITION_LON_BITS)"/>
        </constants>
        <quantity name="position_lat" type="iotdata_double_t" param="latitude">
            <check expr="latitude &lt; (iotdata_double_t)IOTDATA_POSITION_LAT_LOW" error="LAT_LOW" text="Latitude below -90"/>
            <check expr="latitude &gt; (iotdata_double_t)IOTDATA_POSITION_LAT_HIGH" error="LAT_HIGH" text="Latitude above +90"/>
            <impl lang="c" hook="quantise" when="floating" arg="iotdata_double_t lat"><![CDATA[#if !defined(IOTDATA_NO_FLOATING_DOUBLES)
    return (uint32_t)round((lat + (iotdata_double_t)IOTDATA_POSITION_LAT_OFFSET) / (iotdata_double_t)IOTDATA_POSITION_LAT_RANGE * (iotdata_double_t)IOTDATA_POSITION_SCALE);
#else
    return (uint32_t)roundf((lat + (iotdata_double_t)IOTDATA_POSITION_LAT_OFFSET) / (iotdata_double_t)IOTDATA_POSITION_LAT_RANGE * (iotdata_double_t)IOTDATA_POSITION_SCALE);
#endif
]]></impl>
            <impl lang="c" hook="dequantise" when="floating" ret="iotdata_double_t"><![CDATA[    return (iotdata_double_t)raw / (iotdata_double_t)IOTDATA_POSITION_SCALE * (iotdata_double_t)IOTDATA_POSITION_LAT_RANGE - (iotdata_double_t)IOTDATA_POSITION_LAT_OFFSET;
]]></impl>
            <impl lang="c" hook="quantise" when="integer" arg="int32_t lat7"><![CDATA[    return (uint32_t)((((int64_t)lat7 + IOTDATA_POSITION_LAT_OFFSET_I) * IOTDATA_POSITION_SCALE + IOTDATA_POSITION_LAT_OFFSET_I) / IOTDATA_POSITION_LAT_RANGE_I);
]]></impl>
            <impl lang="c" hook="dequantise" when="integer" ret="int32_t"><![CDATA[    return (int32_t)(((int64_t)raw * IOTDATA_POSITION_LAT_RANGE_I + IOTDATA_POSITION_SCALE / 2) / IOTDATA_POSITION_SCALE - IOTDATA_POSITION_LAT_OFFSET_I);
]]></impl>
        </quantity>
        <quantity name="position_lon" type="iotdata_double_t" param="longitude">
            <check expr="longitude &lt; (iotdata_double_t)IOTDATA_POSITION_LON_LOW" error="LON_LOW" text="Longitude below -180"/>
            <check expr="longitude &gt; (iotdata_double_t)IOTDATA_POSITION_LON_HIGH" error="LON_HIGH" text="Longitude above +180"/>
            <impl lang="c" hook="quantise" when="floating" arg="iotdata_double_t lon"><![CDATA[#if !defined(IOTDATA_NO_FLOATING_DOUBLES)
    return (uint32_t)round((lon + (iotdata_double_t)IOTDATA_POSITION_LON_OFFSET) / (iotdata_double_t)IOTDATA_POSITION_LON_RANGE * (iotdata_double_t)IOTDATA_POSITION_SCALE);
#else
    return (uint32_t)roundf((lon + (iotdata_double_t)IOTDATA_POSITION_LON_OFFSET) / (iotdata_double_t)IOTDATA_POSITION_LON_RANGE * (iotdata_double_t)IOTDATA_POSITION_SCALE);
#endif
]]></impl>
            <impl lang="c" hook="dequantise" when="floating" ret="iotdata_double_t"><![CDATA[    return (iotdata_double_t)raw / (iotdata_double_t)IOTDATA_POSITION_SCALE * (iotdata_double_t)IOTDATA_POSITION_LON_RANGE - (iotdata_double_t)IOTDATA_POSITION_LON_OFFSET;
]]></impl>
            <impl lang="c" hook="quantise" when="integer" arg="int32_t lon7"><![CDATA[    return (uint32_t)((((int64_t)lon7 + IOTDATA_POSITION_LON_OFFSET_I) * IOTDATA_POSITION_SCALE + IOTDATA_POSITION_LON_OFFSET_I) / IOTDATA_POSITION_LON_RANGE_I);
]]></impl>
            <impl lang="c" hook="dequantise" when="integer" ret="int32_t"><![CDATA[    return (int32_t)(((int64_t)raw * IOTDATA_POSITION_LON_RANGE_I + IOTDATA_POSITION_SCALE / 2) / IOTDATA_POSITION_SCALE - IOTDATA_POSITION_LON_OFFSET_I);
]]></impl>
        </quantity>
        <impl lang="c" hook="pack"><![CDATA[    const iotdata_field_position_t *const v = vv;
    return bits_write(buf, bb, bp, quantise_position_lat(v->position_lat), IOTDATA_POSITION_LAT_BITS) && bits_write(buf, bb, bp, quantise_position_lon(v->position_lon), IOTDATA_POSITION_LON_BITS);
]]></impl>
        <impl lang="c" hook="unpack"><![CDATA[    iotdata_field_position_t *const v = vv;
    if (*bp + IOTDATA_POSITION_LAT_BITS + IOTDATA_POSITION_LON_BITS > bb)
        return false;
    v->position_lat = dequantise_position_lat(bits_read(buf, bb, bp, IOTDATA_POSITION_LAT_BITS));
    v->position_lon = dequantise_position_lon(bits_read(buf, bb, bp, IOTDATA_POSITION_LON_BITS));
    return true;
]]></impl>
        <impl lang="c" hook="json_get"><![CDATA[    (void)scratch;
    cJSON *j = cJSON_GetObjectItem(root, label);
    if (!j)
        return IOTDATA_OK;
    cJSON *j_latitude = cJSON_GetObjectItem(j, "latitude"), *j_longitude = cJSON_GetObjectItem(j, "longitude");
    if (!j_latitude || !j_longitude)
        return IOTDATA_OK;
    return iotdata_encode_position(enc, (iotdata_double_t)j_latitude->valuedouble, (iotdata_double_t)j_longitude->valuedouble);
]]></impl>
        <impl lang="c" hook="json_set"><![CDATA[    const iotdata_field_position_t *const v = vv;
    (void)scratch;
    cJSON *obj = cJSON_AddObjectToObject(root, label);
#if !defined(IOTDATA_NO_FLOATING)
    json_add_number_fixed(obj, "latitude", (double)v->position_lat, 6);
    json_add_number_fixed(obj, "longitude", (double)v->position_lon, 6);
#else
    cJSON_AddNumberToObject(obj, "latitude", v->position_lat);
    cJSON_AddNumberToObject(obj, "longitude", v->position_lon);
#endif
]]></impl>
        <impl lang="c" hook="dump"><![CDATA[    (void)label;
    size_t s = *bp;
    uint32_t r = bits_read(buf, bb, bp, IOTDATA_POSITION_LAT_BITS);
#if !defined(IOTDATA_NO_FLOATING)
    snprintf(dump->_dec_buf, sizeof(dump->_dec_buf), "%.6f", (double)dequantise_position_lat(r));
#else
    fmt_scaled(dump->_dec_buf, sizeof(dump->_dec_buf), dequantise_position_lat(r), 10000000, "");
#endif
    n = dump_add(dump, n, s, IOTDATA_POSITION_LAT_BITS, r, dump->_dec_buf, "-90..+90", "latitude");
    s = *bp;
    r = bits_read(buf, bb, bp, IOTDATA_POSITION_LON_BITS);
#if !defined(IOTDATA_NO_FLOATING)
    snprintf(dump->_dec_buf, sizeof(dump->_dec_buf), "%.6f", (double)dequantise_position_lon(r));
#else
    fmt_scaled(dump->_dec_buf, sizeof(dump->_dec_buf), dequantise_position_lon(r), 10000000, "");
#endif
    n = dump_add(dump, n, s, IOTDATA_POSITION_LON_BITS, r, dump->_dec_buf, "-180..+180", "longitude");
    return n;
]]></impl>
        <impl lang="c" hook="print"><![CDATA[    const iotdata_field_position_t *const v = vv;
#if !defined(IOTDATA_NO_FLOATING)
    bprintf(bp, "  %s:%s %.6f, %.6f\n", label, _padd(label), (double)v->position_lat, (double)v->position_lon);
#else
    const int32_t lat = v->position_lat, la = lat < 0 ? -lat : lat, lon = v->position_lon, lo = lon < 0 ? -lon : lon;
    bprintf(bp, "  %s:%s %s%d.%06d, %s%d.%06d\n", label, _padd(label), lat < 0 ? "-" : "", (int)(la / 10000000), (int)(la % 10000000), lon < 0 ? "-" : "", (int)(lo / 10000000), (int)(lo % 10000000));
#endif
]]></impl>
    </field>

</fields>
