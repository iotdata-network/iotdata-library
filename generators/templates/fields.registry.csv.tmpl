#
# iotdata_fields.csv - the field registry
#
# GENERATED from specifiers/iotdata-fields-*.xml. 
* Do not edit: the next `make generate` discards it.
#
# A WIDTH OF 0 MEANS VARIABLE, not empty: a field carrying a presence mask over an
# array costs only what its filled slots cost, so there is no fixed number to state.
# The air quality particulate and gas fields and their composite are the three.
#
# bits is the wire width where the specification states it as a plain number;
# where it is an expression (a sum across a composite's parts, say) the column is
# empty and the bits_expr column carries the expression instead.
#
id,name,kind,bits,bits_expr,quantities,parameters,errors,document
{{#each field}}{{r.id}},{{name}},{{r.kind}},{{r.bits}},{{bits}},{{r.quantities}},"{{r.params}}","{{r.errors}}",{{r.document}}
{{/each}}